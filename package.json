{
  "name": "@kosterlang/ksot",
  "version": "0.1.0",
  "description": "Koster Object Table (KSOT) parser and compiler for TypeScript/JavaScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
