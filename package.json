  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/compiler.test.js"
  },
  "keywords": ["ksot", "koster", "json", "parser", "typescript"],
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
